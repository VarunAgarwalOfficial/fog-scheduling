{
  "name": "fog-scheduling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fog and cloud task scheduling simulation that compares priority, shortest-job-first and hybrid policies.",
  "scripts": {
    "compare": "node src/cli.ts compare",
    "theory": "node src/cli.ts theory",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
